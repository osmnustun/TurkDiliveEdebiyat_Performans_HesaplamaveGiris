@page
@model IndexModel
@{
    ViewData["Title"] = "Ana Sayfa";
    ViewData["Active"] = "home";
}

<div class="page-head">
    <div class="eyebrow">2026-2027 · 1. Dönem</div>
    <h1>Performans Karnesi</h1>
    <p>Sınıf seçin, öğrencileri değerlendirin, dönem sonu puanlarını otomatik görün.</p>
</div>

@if (Model.Classes.Count == 0)
{
    <div class="empty">
        <b>Henüz sınıf yok</b>
        Excel dosyalarınızdan öğrencileri içe aktararak başlayın.
        <div class="mt-3 d-flex gap-2 justify-content-center flex-wrap">
            <a asp-page="/IceAktar/Index" class="btn-app">Excel ile öğrenci al</a>
            <a asp-page="/Siniflar/Index" class="btn-app-outline">Sınıf ekle</a>
        </div>
    </div>
}
else
{
    <div class="stat-grid">
        <div class="stat"><b>@Model.StudentCount</b><span>Öğrenci</span></div>
        <div class="stat"><b>@Model.Classes.Count</b><span>Sınıf</span></div>
        <div class="stat"><b>%@Model.Percent</b><span>Tamamlandı</span></div>
    </div>

    <div class="card-app mt-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <b style="font-size:14.5px">Genel ilerleme</b>
            <span class="badge-soft">@Model.Scored / @Model.Expected bileşen</span>
        </div>
        <div class="progress"><span style="width:@Model.Percent%"></span></div>
        <div class="small muted mt-2">Her bileşen, tüm grupları puanlandığında tamamlanmış sayılır.</div>
    </div>

    <div class="section-title">
        <h2>Sınıflar</h2>
        <a asp-page="/Siniflar/Index">Sınıf yönetimi →</a>
    </div>

    <div class="class-grid">
        @foreach (var item in Model.Classes)
        {
            <a asp-page="/Sonuclar/Index" asp-route-classId="@item.Id" class="class-card">
                <span class="class-letter">@item.Name</span>
                <div class="class-info">
                    <b>@item.Name Sınıfı</b>
                    <small>@item.StudentCount öğrenci · @item.Scored/@item.Expected bileşen</small>
                    <div class="progress thin mt-2"><span style="width:@item.Percent%"></span></div>
                </div>
                <svg class="go" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            </a>
        }
    </div>

    <div class="section-title"><h2>Hızlı işlemler</h2></div>
    <div class="d-grid gap-2">
        <a asp-page="/Degerlendirme/Index" class="btn-app btn-block">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
            Not girişine başla
        </a>
        <a asp-page="/IceAktar/Index" class="btn-app-outline btn-block">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>
            Excel ile öğrenci al
        </a>
    </div>
}
