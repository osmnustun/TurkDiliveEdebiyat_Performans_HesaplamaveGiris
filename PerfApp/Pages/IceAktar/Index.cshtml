@page
@model PerfApp.Pages.IceAktar.IndexModel
@{
    ViewData["Title"] = "Excel'den Öğrenci Ekle";
    ViewData["Active"] = "import";
}

<div class="page-head">
    <div class="eyebrow">Öğrenci Yönetimi</div>
    <h1>Excel'den Öğrenci Ekle</h1>
    <p>Şablonu indirin, doldurun ve yükleyin. Sınıf sistemde yoksa otomatik oluşturulur.</p>
</div>

<div class="card-app">
    <div class="step-badge">1</div>
    <h2 class="card-title">Şablonu indir</h2>
    <p class="small muted" style="margin:6px 0 10px">
        Şablonda üç sütun vardır: <b>Öğrenci No</b> · <b>Ad Soyad</b> · <b>Sınıf</b>.
        Sınıfı <b>9/C</b>, <b>10/A</b> gibi yazın. Başlık satırını değiştirmeyin.
    </p>
    <a asp-page="/IceAktar/Index" asp-page-handler="Template" class="btn-app-outline btn-block">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>
        Şablonu indir (.xlsx)
    </a>

    <div class="divider"></div>
    <div class="tpl-preview" aria-hidden="true">
        <div class="tpl-row tpl-head">
            <span>Öğrenci No</span><span>Ad Soyad</span><span>Sınıf</span>
        </div>
        <div class="tpl-row"><span>1254</span><span>ELİF YILMAZ</span><span>9/C</span></div>
        <div class="tpl-row"><span>1260</span><span>AHMET DEMİR</span><span>10/A</span></div>
    </div>
</div>

<div class="card-app">
    <div class="step-badge">2</div>
    <h2 class="card-title">Doldurduğunuz dosyayı yükleyin</h2>
    <form method="post" asp-page-handler="Preview" enctype="multipart/form-data" style="margin-top:10px">
        <label class="form-label-app" for="file">Excel dosyası (.xlsx)</label>
        <input id="file" type="file" name="file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" class="input-app" style="padding:9px" required />
        <button type="submit" class="btn-app btn-block mt-3">Dosyayı incele</button>
    </form>
</div>

@if (Model.Preview is not null)
{
    var newClassCount = Model.PreviewClasses.Count(c => c.IsNewClass);
    <div class="card-app mt-3" style="border-color:#99d6cd">
        <div class="d-flex justify-content-between align-items-start gap-2">
            <div>
                <div class="eyebrow">Önizleme</div>
                <h2 style="font-size:17px;font-weight:800;margin:2px 0 4px">@Model.Preview.Count öğrenci · @Model.PreviewClasses.Count sınıf bulundu</h2>
                <div class="small muted">@Model.PreviewFile</div>
            </div>
            <a asp-page="/IceAktar/Index" class="small muted">İptal</a>
        </div>

        @if (newClassCount > 0)
        {
            <div class="alert-app info mt-3"><b>@newClassCount sınıf yeni oluşturulacak.</b> Sınıflar öğrencilerle birlikte otomatik eklenir.</div>
        }

        @if (Model.PreviewWarnings.Count > 0)
        {
            <div class="alert-app danger mt-3">
                @foreach (var warning in Model.PreviewWarnings)
                {
                    <div>@warning</div>
                }
            </div>
        }

        <div class="divider"></div>
        <div class="student-list">
            @foreach (var cls in Model.PreviewClasses)
            {
                <div class="student-row">
                    <span class="avatar">@cls.ClassName</span>
                    <div class="student-name">
                        <b>@cls.ClassName Sınıfı</b>
                        <small>@cls.Count öğrenci</small>
                    </div>
                    @if (cls.IsNewClass)
                    {
                        <span class="badge-ok">YENİ</span>
                    }
                    else
                    {
                        <span class="badge-soft">MEVCUT</span>
                    }
                </div>
            }
        </div>

        <form method="post" asp-page-handler="Confirm" class="mt-3" data-submit-once>
            <input type="hidden" name="token" value="@Model.Token" />
            <button type="submit" class="btn-app btn-block">@Model.Preview.Count öğrenciyi içe aktar</button>
        </form>
    </div>
}

<details class="card-app mt-3">
    <summary style="cursor:pointer;font-weight:800;font-size:14px">Gelişmiş: klasördeki performans dosyalarından tarama</summary>
    <div class="divider"></div>
    <p class="small muted mb-2">Uygulamanın üst klasöründeki tüm .xlsx dosyaları (performans ölçeği biçiminde) taranır. Mevcut sınıflarda yalnızca eksik öğrenciler eklenir.</p>
    <form method="post" asp-page-handler="Folder" data-confirm="Üst klasördeki tüm Excel dosyaları taranacak. Devam edilsin mi?">
        <button type="submit" class="btn-app-outline btn-block" disabled="@(Model.FolderFileCount == 0)">
            Klasörü tara (@Model.FolderFileCount dosya)
        </button>
    </form>
</details>

<div class="card-app mt-3">
    <h2 class="card-title">Mevcut sınıflar</h2>
    @if (Model.Classes.Count == 0)
    {
        <div class="small muted">Henüz sınıf yok. Şablonu yükleyerek ilk sınıfı oluşturabilirsiniz.</div>
    }
    else
    {
        foreach (var cls in Model.Classes)
        {
            <a asp-page="/Ogrenciler/Index" asp-route-classId="@cls.Id" class="student-row">
                <span class="avatar">@cls.Name</span>
                <div class="student-name"><b>@cls.Name Sınıfı</b><small>Öğrenci listesine git</small></div>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m9 18 6-6-6-6"/></svg>
            </a>
        }
    }
</div>
