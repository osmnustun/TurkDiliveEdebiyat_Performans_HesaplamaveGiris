@page
@model PerfApp.Pages.Degerlendirme.IndexModel
@{
    ViewData["Title"] = "Not Girişi";
    ViewData["Active"] = "score";
}

<div class="page-head">
    <div class="eyebrow">1. Dönem</div>
    <h1>Not Girişi</h1>
    <p>Sınıf ve bileşen seçin. Her bileşende 3-5 grup için 0-100 arası puan verin.</p>
</div>

@if (Model.Classes.Count == 0)
{
    <div class="empty">
        <b>Henüz sınıf yok</b>
        Önce öğrencileri içe aktarın.
        <div class="mt-3"><a asp-page="/IceAktar" class="btn-app">Excel'den aktar</a></div>
    </div>
}
else
{
    <div class="chip-row">
        @foreach (var cls in Model.Classes)
        {
            <a asp-page="/Degerlendirme/Index" asp-route-classId="@cls.Id" asp-route-sort="@Model.Sort"
               class="chip @(cls.Id == Model.SelectedClassId ? "active" : "")">@cls.Name</a>
        }
    </div>

    <div class="sort-row">
        <span class="sort-label">Öğrenci sırası:</span>
        <div class="sort-toggle" role="group" aria-label="Öğrenci sıralaması">
            <a asp-page="/Degerlendirme/Index" asp-route-classId="@Model.SelectedClassId" asp-route-sort="no"
               class="@(Model.Sort == "no" ? "active" : "")">Okul No</a>
            <a asp-page="/Degerlendirme/Index" asp-route-classId="@Model.SelectedClassId" asp-route-sort="ad"
               class="@(Model.Sort == "ad" ? "active" : "")">Ad Soyad</a>
        </div>
    </div>

    <div class="alert-app info mb-3">
        <b>Nasıl çalışır?</b> Grup puanı, gruptaki ölçütlere maksimum puanları oranında dağıtılır. Bileşen puanı 100'lük sisteme çevrilir; dönem sonu puanı Excel formülleriyle otomatik hesaplanır.
    </div>

    @if (Model.P1.Count > 0)
    {
        <div class="section-title">
            <h2>1. Performans</h2>
            <span>4 bileşen · %25'er</span>
        </div>
        @foreach (var vm in Model.P1)
        {
            <partial name="_ComponentCard" model="vm" />
        }
    }

    @if (Model.P2.Count > 0)
    {
        <div class="section-title">
            <h2>2. Performans</h2>
            <span>Kitap %33 + %33 · Ders içi %34</span>
        </div>
        @foreach (var vm in Model.P2)
        {
            <partial name="_ComponentCard" model="vm" />
        }
    }
}
