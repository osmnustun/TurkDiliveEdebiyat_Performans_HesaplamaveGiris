@page
@model PerfApp.Pages.Ogrenciler.IndexModel
@{
    ViewData["Title"] = "Öğrenciler";
    ViewData["Active"] = "students";
}

<div class="page-head">
    <div class="eyebrow">Yönetim</div>
    <h1>Öğrenciler</h1>
    <p>Öğrenci ekleyin, bilgilerini düzenleyin veya sınıfını değiştirin.</p>
</div>

@if (Model.Classes.Count == 0)
{
    <div class="empty">
        <b>Henüz sınıf yok</b>
        Önce bir sınıf oluşturun.
        <div class="mt-3"><a asp-page="/Siniflar/Index" class="btn-app">Sınıf ekle</a></div>
    </div>
}
else
{
    <div class="chip-row">
        @foreach (var cls in Model.Classes)
        {
            <a asp-page="/Ogrenciler/Index" asp-route-classId="@cls.Id" asp-route-sort="@Model.Sort"
               class="chip @(cls.Id == Model.SelectedClassId ? "active" : "")">
                @cls.Name <small>@cls.Students.Count</small>
            </a>
        }
        <a asp-page="/Siniflar/Index" class="chip" title="Sınıf yönetimi">＋</a>
    </div>

    <div class="d-flex gap-2 mb-2">
        <form method="get" class="flex-grow-1">
            <input type="hidden" name="classId" value="@Model.SelectedClassId" />
            <input type="hidden" name="sort" value="@Model.Sort" />
            <input name="q" value="@Model.Query" class="input-app" placeholder="İsim veya numara ara" autocomplete="off" />
        </form>
        <a asp-page="/IceAktar" asp-route-classId="@Model.SelectedClassId" class="btn-app-outline" style="min-height:48px;padding:0 14px" title="Excel'den aktar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>
        </a>
    </div>

    <div class="sort-row">
        <span class="sort-label">Sırala:</span>
        <div class="sort-toggle" role="group" aria-label="Öğrenci sıralaması">
            <a asp-page="/Ogrenciler/Index" asp-route-classId="@Model.SelectedClassId" asp-route-q="@Model.Query" asp-route-sort="no"
               class="@(Model.Sort == "no" ? "active" : "")">Okul No</a>
            <a asp-page="/Ogrenciler/Index" asp-route-classId="@Model.SelectedClassId" asp-route-q="@Model.Query" asp-route-sort="ad"
               class="@(Model.Sort == "ad" ? "active" : "")">Ad Soyad</a>
        </div>
    </div>

    @if (Model.EditStudent is not null)
    {
        <div class="card-app mb-3" style="border-color:#99d6cd;background:#fbfefd">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <b>Öğrenciyi düzenle</b>
                <a asp-page="/Ogrenciler/Index" asp-route-classId="@Model.SelectedClassId" asp-route-sort="@Model.Sort" class="small muted">Vazgeç</a>
            </div>
            <form method="post" asp-page-handler="Update">
                <input type="hidden" name="id" value="@Model.EditStudent.Id" />
                <input type="hidden" name="sort" value="@Model.Sort" />
                <div class="form-grid">
                    <div>
                        <label class="form-label-app">Okul no</label>
                        <input name="number" value="@Model.EditStudent.Number" class="input-app" inputmode="numeric" />
                    </div>
                    <div>
                        <label class="form-label-app">Sınıf</label>
                        <select name="classId" class="select-app">
                            @foreach (var cls in Model.Classes)
                            {
                                <option value="@cls.Id" selected="@(cls.Id == Model.EditStudent.SchoolClassId ? "selected" : null)">@cls.Name</option>
                            }
                        </select>
                    </div>
                    <div class="full">
                        <label class="form-label-app">Adı soyadı</label>
                        <input name="fullName" value="@Model.EditStudent.FullName" class="input-app" required />
                    </div>
                </div>
                <button type="submit" class="btn-app btn-block mt-3">Değişiklikleri kaydet</button>
            </form>
        </div>
    }

    <div class="card-app">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <b style="font-size:14.5px">@Model.SelectedClass?.Name listesi</b>
            <span class="badge-soft">@Model.Students.Count öğrenci</span>
        </div>

        @if (Model.Students.Count == 0)
        {
            <div class="empty" style="border:0;padding:26px 8px">
                <b>Kayıt bulunamadı</b>
                @(string.IsNullOrWhiteSpace(Model.Query) ? "Aşağıdaki formdan öğrenci ekleyin veya Excel'den aktarın." : "Arama kriterine uyan öğrenci yok.")
            </div>
        }
        else
        {
            <div class="student-list">
                @foreach (var student in Model.Students)
                {
                    <div class="student-row">
                        <span class="avatar">@Ui.Initials(student.FullName)</span>
                        <div class="student-name">
                            <b>@student.FullName</b>
                            <small>@(student.Number is null ? "Numara yok" : "No: " + student.Number)</small>
                        </div>
                        <div class="row-actions">
                            <a asp-page="/Ogrenciler/Index" asp-route-classId="@Model.SelectedClassId" asp-route-editId="@student.Id" asp-route-sort="@Model.Sort"
                               class="mini-btn" title="Düzenle">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                            </a>
                            <form method="post" asp-page-handler="Delete" data-confirm="@student.FullName silinecek. Bu öğrencinin tüm puanları da silinir. Emin misiniz?">
                                <input type="hidden" name="id" value="@student.Id" />
                                <input type="hidden" name="classId" value="@Model.SelectedClassId" />
                                <input type="hidden" name="sort" value="@Model.Sort" />
                                <button type="submit" class="mini-btn danger" title="Sil">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="mt-3">
        <details class="card-app">
            <summary style="cursor:pointer;font-weight:800;font-size:14.5px">＋ Yeni öğrenci ekle</summary>
            <div class="divider"></div>
            <form method="post" asp-page-handler="Add">
                <input type="hidden" name="classId" value="@Model.SelectedClassId" />
                <input type="hidden" name="sort" value="@Model.Sort" />
                <div class="form-grid">
                    <div>
                        <label class="form-label-app">Okul no</label>
                        <input name="number" class="input-app" inputmode="numeric" placeholder="Örn. 123" />
                    </div>
                    <div>
                        <label class="form-label-app">Sınıf</label>
                        <input class="input-app" value="@Model.SelectedClass?.Name" disabled />
                    </div>
                    <div class="full">
                        <label class="form-label-app">Adı soyadı</label>
                        <input name="fullName" class="input-app" placeholder="ÖRN. ELİF YILMAZ" required />
                    </div>
                </div>
                <button type="submit" class="btn-app btn-block mt-3">Öğrenciyi ekle</button>
            </form>
        </details>
    </div>
}
